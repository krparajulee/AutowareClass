<?xml version="1.0" encoding="UTF-8" ?>
<!-- ======================================================================= -->
<!-- AutowareClass2020 - Chapter 04: FastDDS Shared Memory Configuration    -->
<!-- Enables SHM zero-copy communication for intra-host nodes                -->
<!-- ======================================================================= -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <participant profile_name="autoware_fastdds_participant" is_default_profile="true">
        <rtps>
            <useBuiltinTransports>false</useBuiltinTransports>
            <userTransports>
                <transport_id>shm_transport</transport_id>
                <transport_id>udp_transport</transport_id>
            </userTransports>
        </rtps>
    </participant>

    <transport_descriptors>
        <transport_descriptor>
            <transport_id>shm_transport</transport_id>
            <type>SHM</type>
            <max_message_size>1048576</max_message_size>
        </transport_descriptor>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
</profiles>
